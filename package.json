{
  "name": "rusty-caltrop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A small game engine in TypeScript, built as a learning exercise.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-ratchet.mjs check",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check-deps": "node scripts/check-dep-versions.mjs",
    "wiki-lint": "node scripts/check-wiki.mjs check",
    "preflight": "npm run typecheck && npm run lint && npm run test && npm run check-deps"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "knip": "^6.34.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
